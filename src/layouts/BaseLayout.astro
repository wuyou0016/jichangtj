---
import { siteConfig } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  // 页面类型，绝大多数页面是 website；未来如果做成文章型页面可以传 article。
  ogType?: 'website' | 'article';
  // 分享图的站内路径（比如 /images/og/default.png），不传就用全站默认图。
  ogImage?: string;
  // 文章型页面的发布/更新时间（YYYY-MM-DD），输出 article:published_time / modified_time。
  publishedTime?: string;
  modifiedTime?: string;
  // 404 等不该被收录的页面：输出 noindex，且不输出 canonical。
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImageUrl = new URL(ogImage ?? siteConfig.defaultOgImage, siteConfig.url).toString();

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.brandName,
  url: siteConfig.url,
  description: siteConfig.description,
  inLanguage: siteConfig.language,
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.brandName,
  url: siteConfig.url,
  logo: new URL('/favicon.svg', siteConfig.url).toString(),
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="site-header__brand">
          <span class="site-header__logo">✈️</span>
          <span>
            <strong>{siteConfig.brandName}</strong>
            <small>机场推荐 · 实测数据 · Clash 教程</small>
          </span>
        </a>
        <button type="button" class="site-header__toggle" aria-expanded="false" aria-controls="site-nav">
          <span>菜单</span>
        </button>
        <nav class="site-header__nav" id="site-nav">
          <a href="/">首页</a>
          <a href="/rankings/">机场推荐</a>
          <a href="/scenarios/">按场景选</a>
          <a href="/airports/">机场导航</a>
          <a href="/tests/">实测数据</a>
          <a href="/clash/">Clash 教程</a>
          <a href="/tutorials/">使用教程</a>
          <a href="/methodology/">评测方法</a>
        </nav>
      </div>
    </header>
    <script>
      const toggle = document.querySelector('.site-header__toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    </script>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div>
          <h2>{siteConfig.brandName}</h2>
          <p>{siteConfig.tagline}</p>
        </div>
        <div>
          <h2>主要导航</h2>
          <ul>
            <li><a href="/">首页</a></li>
            <li><a href="/rankings/">机场推荐排行榜</a></li>
            <li><a href="/scenarios/">按场景选机场</a></li>
            <li><a href="/airports/">机场导航</a></li>
            <li><a href="/tests/">机场实测数据</a></li>
          </ul>
        </div>
        <div>
          <h2>梯子教程</h2>
          <ul>
            <li><a href="/clash/">Clash 教程与客户端</a></li>
            <li><a href="/tutorials/clash-verge-rev-tutorial/">Clash Verge Rev 教程</a></li>
            <li><a href="/tutorials/shadowrocket-tutorial/">小火箭 Shadowrocket 教程</a></li>
            <li><a href="/tutorials/v2rayn-tutorial/">v2rayN 教程</a></li>
            <li><a href="/tutorials/">全部使用教程</a></li>
          </ul>
        </div>
        <div>
          <h2>网站说明</h2>
          <ul>
            <li><a href="/methodology/">评测方法与数据说明</a></li>
            <li><a href="/about/">关于机场TJ</a></li>
            <li><a href="/contact/">联系方式</a></li>
            <li><a href="/privacy/">隐私政策</a></li>
            <li><a href="/terms/">服务条款与免责声明</a></li>
            <li><a href="https://t.me/xxxxtony" target="_blank" rel="nofollow noopener">入驻申请</a></li>
          </ul>
        </div>
        <div class="site-footer__friendlinks">
          <h2>友情链接</h2>
          <ul>
            <li><a href="https://rocketjichang.com" target="_blank" rel="noopener">火箭机场</a></li>
            <li><a href="https://jichangbao.com" target="_blank" rel="noopener">机场宝</a></li>
            <li><a href="https://ejichang.com" target="_blank" rel="noopener">机场E家</a></li>
          </ul>
        </div>
      </div>
      <div class="container site-footer__bottom">
        <p>&copy; {new Date().getFullYear()} {siteConfig.brandName}（{siteConfig.brandNameEn}）</p>
      </div>
    </footer>
  </body>
</html>
