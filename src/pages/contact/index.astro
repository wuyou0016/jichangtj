---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveCanonicalUrl } from '../../config/seo';

const title = '联系方式｜机场TJ';
const description = '如何向机场TJ反馈信息错误、提交服务商资料修正建议。';
const canonicalUrl = resolveCanonicalUrl('/contact/');
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <nav aria-label="Breadcrumb"><a href="/">首页</a> › 联系方式</nav>

  <h1>联系方式</h1>
  <p>
    发现某个服务商的信息有误、过时，或者你有更准确的第三方资料来源，欢迎告诉我们。目前反馈渠道是本站的
    <a href="https://github.com/wuyou0016/jichangtj/issues" target="_blank" rel="noopener">GitHub 仓库 Issues</a>，
    提交时请尽量说明具体是哪个服务商、哪条信息，以及你参考的来源。
  </p>
  <p>核实后会在对应服务商详情页更新信息，并同步更新页面上的最后更新时间。</p>

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/methodology/">评测方法与数据说明</a></li>
    <li><a href="/about/">关于机场TJ</a></li>
    <li><a href="/">返回首页</a></li>
  </ul>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonicalUrl,
    })}
  />
</BaseLayout>
