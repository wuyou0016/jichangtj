---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/Crumbs.astro';
import Chip from '../../components/Chip.astro';
import Faq from '../../components/Faq.astro';
import { DATA_CONFIDENCE_LABEL, type DataConfidence } from '../../config/data-confidence';
import { resolveCanonicalUrl } from '../../config/seo';

const order: DataConfidence[] = ['own-test', 'cross-verified', 'third-party-only', 'incomplete'];
const explain: Record<DataConfidence, string> = {
  'own-test': '本站对该服务商做过真实测试（比如持续跟踪的丢包率测试，或流媒体解锁检测），测试方法见下文。',
  'cross-verified': '本站没有对该服务商做测试，但找到 2 个以上互相独立的第三方来源，关键信息（比如价格、套餐结构）能互相印证。',
  'third-party-only': '只找到单一第三方来源，或多个来源之间还没有互相印证的关键信息，需要用户自行多方核实。',
  incomplete: '该服务商刚收录，或目前只有很有限的资料，信息完整度还在积累中。',
};
const faq = [
  { q: '标签是评分吗？', a: '不是。标签只说明“这份资料是怎么来的”，不代表服务好不好，也不用来暗示风险。' },
  { q: '为什么不测下载速度？', a: '下载速度受你所在地区、运营商、时段影响很大，在单一环境下测出的数字对其他人参考价值很低，本站暂不发布，也不转引别人的速度数字。' },
  { q: '站长自测的数据可信吗？', a: '本站如实写明了环境、工具、范围和局限。它是一个人在固定网络下的观察，不是第三方审计，请当作参考起点，并按“一周自测计划”自己验证。' },
  { q: '价格为什么不统一换算成每 GB 单价？', a: '倍率、设备数、节点范围、周期不同，直接换算很容易误导。本站只写各家公开的价格口径，并提供让你自己换算的工具。' },
];
const title = '评测方法与数据说明：来源分类、数据可信度标签与测试局限｜机场TJ';
const description = '机场TJ 如何区分官方公开信息、第三方资料和站长自测数据；数据可信度标签的含义；丢包率与解锁检测的具体做法、环境与局限；价格口径与排行榜的处理方式；资料更正流程，方便你自己判断数据可信度。';
---

<BaseLayout title={title} description={description} canonical={resolveCanonicalUrl('/methodology/')}>
  <Crumbs items={[{ name: '评测方法与数据说明', href: '/methodology/' }]} />
  <div class="banner">
    <p class="eyebrow">方法 · Methodology</p>
    <h1>评测方法与数据说明</h1>
    <p class="lead">机场TJ 上每个服务商的信息，都明确标注了来源：是官方自己说的、第三方资料整理的，还是本站测试出来的。这三类信息可信度不一样，混在一起写会误导人，所以分开列出。</p>
  </div>

  <div class="split" style="margin-top:26px">
    <div class="article-body article">
      <h2 id="sources">三类信息来源</h2>
      <div class="cards cards--2" style="margin-bottom:1.4em">
        <div class="card"><h3>官方公开信息</h3><p class="muted">来自服务商自己的官网、公告或客服回复，本站尽量核实，但官方信息本身可能随时调整，购买前建议直接看官网最新内容。</p></div>
        <div class="card"><h3>第三方资料</h3><p class="muted">来自其他机场导航站、评测站或社区讨论，本站会标注具体来源名称、链接和日期，不会把别人的资料包装成本站测试结果。</p></div>
        <div class="card"><h3>本站自测</h3><p class="muted">站长实际测试得到的数据，目前主要是丢包率的持续跟踪，个别服务商额外做过流媒体解锁检测，方法见下文。</p></div>
      </div>

      <h2 id="labels">数据可信度标签是什么意思</h2>
      <p>每个服务商卡片上都有一个标签，说明这份资料“是怎么来的”。它不是打分，也不代表服务好不好。</p>
      <div class="tbl-wrap">
        <table class="tbl" style="min-width:520px">
          <thead><tr><th>标签</th><th>代表什么</th></tr></thead>
          <tbody>{order.map((k) => <tr><th scope="row"><Chip c={k} /></th><td>{explain[k]}</td></tr>)}</tbody>
        </table>
      </div>

      <h2 id="verify">本站能验证什么，不能验证什么</h2>
      <div class="fit">
        <div class="yes"><h3>能验证</h3><ul><li>丢包率（在站长测试所用的网络环境下持续跟踪）</li><li>部分服务商的流媒体解锁情况（实际访问检测，不是看宣传语）</li><li>多个第三方来源的信息是否互相印证（比如价格、套餐结构）</li></ul></div>
        <div class="no"><h3>暂不能验证</h3><ul><li>下载 / 上传速率、延迟等其他测速维度</li><li>不同地区、不同运营商网络下的实际表现</li><li>服务商的长期运营稳定性、客服响应质量</li><li>官方宣传的线路架构（如“IPLC 专线”）是否与实际一致</li></ul></div>
      </div>

      <h2 id="how">本站测试具体怎么做的</h2>
      <ol class="route" style="margin-bottom:1.4em">
        <li><h3>丢包率：持续跟踪，不是测一次</h3><p>使用 MiaoKo 自定义测速工具，在珠海联通网络环境下持续跟踪测试。同一个服务商会在不同日期反复测，把结果记录下来；服务商详情页里“站长自测”部分标注的百分比区间，就是多次测试结果的范围，不是单次数据。</p></li>
        <li><h3>流媒体解锁：用节点实际访问</h3><p>目前只对少数服务商做过。方法是用该服务商的节点实际访问 YouTube、Netflix、Disney+ 等平台，记录能否正常观看，不是看宣传语。检测里出现的异常（如被识别为“送中”的节点）也如实保留。</p></li>
        <li><h3>资料收集：官方入口 + 第三方来源</h3><p>先尝试打开官方入口。遇到验证码、注册墙、中转页或访问失败时，如实写在“官方入口”一栏，不会为了写全而编造内容；再收集第三方来源并标注来源与日期。</p></li>
        <li><h3>价格：只写口径，不横向换算</h3><p>包月价、年付折算价、活动价分开写，并说明依据（站长确认、多来源一致，还是单一来源）。不做品牌之间每 GB 单价的换算。</p></li>
      </ol>

      <h2 id="ranking">排行榜与场景推荐怎么来的</h2>
      <p>综合排行榜和场景推荐是<b>编辑判断</b>，不是客观算分——因为本站没有可比较的结构化数据，写了评分就是编。每一条推荐都附理由、数据来源与需要留意的地方。排序主要看三件事：价格资料是否有多来源印证或站长确认、本站是否有测试数据、官方入口与资料是否透明。</p>

      <h2 id="limits">这套方法的局限性</h2>
      <div class="callout callout--warn"><b>局限</b><div><ul style="margin:0">
        <li>测试由站长一人在固定网络环境下进行，不代表所有地区、所有运营商线路的实际体验，你自己的网络环境可能测出不同结果。</li>
        <li>目前只对丢包率做持续跟踪，速率、延迟、稳定性等其他维度暂无本站测试数据，卡片和详情页里没写的部分就是本站还没测。</li>
        <li>第三方资料本身也可能过时或有误，本站会标注日期，但不代表资料截取当下依然准确。</li>
        <li>不管标签是什么，正式购买前都建议先用小额套餐或免费试用自己验证一遍，尤其是标注“仅第三方资料”或“信息待补充”的服务商。</li>
      </ul></div></div>

      <h2 id="correct">发现有误怎么办</h2>
      <p>资料有误或过时，请通过<a href="/contact/">联系方式</a>告诉我们，并尽量说明是哪个服务商、哪条信息、你参考的来源。核实后会更新对应页面，并同步更新页面上的“最后更新时间”，重要调整记录在<a href="/updates/">更新日志</a>。</p>

      <h2 id="faq">常见问题</h2>
      <Faq items={faq} />
      <p class="muted" style="margin-top:1.4em">你可能还想看：<a href="/data/">数据中心</a>、<a href="/rankings/">综合排行榜</a>、<a href="/knowledge/self-test-seven-days/">一周自测计划</a>、<a href="/scenarios/">按场景选</a>。</p>
    </div>
    <aside class="aside">
      <div class="toc"><h2>本页目录</h2><ol>
        <li><a href="#sources">三类信息来源</a></li><li><a href="#labels">可信度标签</a></li><li><a href="#verify">能 / 不能验证</a></li><li><a href="#how">测试怎么做的</a></li><li><a href="#ranking">排行榜怎么来的</a></li><li><a href="#limits">局限性</a></li><li><a href="#correct">发现有误</a></li><li><a href="#faq">常见问题</a></li>
      </ol></div>
    </aside>
  </div>
</BaseLayout>
