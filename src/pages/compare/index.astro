---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/Crumbs.astro';
import Chip from '../../components/Chip.astro';
import Faq from '../../components/Faq.astro';
import { loadSite, safeJson } from '../../data/helpers';
import { FACTS, CLIENT_LABEL, ENTRY_LABEL } from '../../data/providers/facts';
import { DATA_CONFIDENCE_LABEL, type DataConfidence } from '../../config/data-confidence';
import { resolveCanonicalUrl } from '../../config/seo';

const { providers, rankOf } = await loadSite();
const rows = [...providers].sort((a, b) => (rankOf.get(a.id) ?? 99) - (rankOf.get(b.id) ?? 99)).map((p) => {
  const f = FACTS[p.id]!;
  return {
    id: p.id,
    slug: p.data.slug,
    name: p.data.name,
    rank: rankOf.get(p.id) ?? 0,
    conf: p.data.dataConfidence as DataConfidence,
    confLabel: DATA_CONFIDENCE_LABEL[p.data.dataConfidence as DataConfidence],
    price: f.price.headline,
    basis: f.price.basis,
    lossMin: f.loss?.min ?? null,
    lossMax: f.loss?.max ?? null,
    loss: f.loss ? `${f.loss.min}%–${f.loss.max}%` : '暂无数据',
    client: f.client.type,
    clientLabel: CLIENT_LABEL[f.client.type],
    clientText: f.client.text,
    entry: ENTRY_LABEL[f.entry.kind],
    protocols: f.protocols,
    unlock: f.unlock ?? '本站未做检测',
    flags: f.flags.join('；'),
  };
});
const labels = Object.entries(DATA_CONFIDENCE_LABEL) as [DataConfidence, string][];
const faq = [
  { q: '为什么不给每 GB 单价排名？', a: '倍率、设备数、节点范围和周期都不同，直接换算很容易误导。本站只并排列出各家公开的价格口径，你可以用“流量成本换算”工具按自己的情况算。' },
  { q: '丢包率能直接比较吗？', a: '同一测试环境下的区间可以参考相对高低，但它是站长在固定网络（珠海联通）下的多批次数据，不代表你的网络。没有数据的服务商并不意味着更差，只是本站没测。' },
  { q: '表格里的“客户端”是什么意思？', a: '“仅官方客户端”表示资料显示不能导入 Clash 等第三方客户端；“说法不一”表示不同来源互相矛盾；“资料未提及”表示没有可核实的信息，需要你购买前问清楚。' },
];
const title = '机场对比 2026：9 家服务商价格口径、丢包率与客户端并排看｜机场TJ';
const description = '机场TJ 服务商对比中心：9 家机场代理的起步价口径、站长自测丢包率区间、客户端支持、官方入口情况与资料标签并排列出，可筛选、可排序，并支持两家服务商逐项对比。';
---

<BaseLayout title={title} description={description} canonical={resolveCanonicalUrl('/compare/')}>
  <Crumbs items={[{ name: '服务商对比', href: '/compare/' }]} />
  <div class="banner">
    <p class="eyebrow">对比中心 · Compare</p>
    <h1>服务商对比：价格口径、丢包率与客户端</h1>
    <p class="lead">把 9 家服务商的关键信息并排放在一张表里。价格只列各家公开的口径，丢包率是站长自测区间，没有数据就写“暂无”。点表头排序，点标签筛选。</p>
  </div>

  <section class="sec" style="margin-top:28px">
    <div class="filters" role="group" aria-label="资料标签筛选">
      <span class="lab">资料标签</span>
      <button class="pill" type="button" data-conf="all" aria-pressed="true">全部</button>
      {labels.map(([k, l]) => <button class="pill" type="button" data-conf={k} aria-pressed="false">{l}</button>)}
    </div>
    <div class="filters" role="group" aria-label="客户端筛选">
      <span class="lab">客户端</span>
      <button class="pill" type="button" data-client="all" aria-pressed="true">全部</button>
      <button class="pill" type="button" data-client="official-only" aria-pressed="false">仅官方客户端</button>
      <button class="pill" type="button" data-client="conflict" aria-pressed="false">说法不一</button>
      <button class="pill" type="button" data-client="unknown" aria-pressed="false">资料未提及</button>
      <button class="pill" type="button" id="only-loss" aria-pressed="false">只看有丢包数据</button>
    </div>

    <div class="tbl-wrap">
      <table class="tbl" id="cmp" style="min-width:880px">
        <thead>
          <tr>
            <th aria-sort="ascending"><button type="button" data-sort="rank">名次</button></th>
            <th>服务商</th>
            <th>起步价口径</th>
            <th><button type="button" data-sort="loss">丢包率（自测）</button></th>
            <th>客户端</th>
            <th>官方入口</th>
            <th>资料标签</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr data-rank={r.rank} data-conf={r.conf} data-client={r.client} data-loss={r.lossMin ?? ''} data-has-loss={r.lossMin === null ? '0' : '1'}>
                <td class="num"><b>{String(r.rank).padStart(2, '0')}</b></td>
                <th scope="row"><a href={`/airports/${r.slug}/`}>{r.name}</a>{r.rank === 1 && <span class="tag tag--amber" style="margin-left:6px">首推</span>}</th>
                <td>{r.price}<br /><span class="muted" style="font-size:.8rem">{r.basis}</span></td>
                <td class="num">{r.loss}</td>
                <td>{r.clientLabel}</td>
                <td>{r.entry}</td>
                <td><Chip c={r.conf} /></td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p id="cmp-empty" class="muted hide">没有符合条件的服务商。</p>
  </section>

  <section class="sec">
    <div class="sec-head"><div><p class="eyebrow">两两对比 · Head to head</p><h2>选两家，逐项对比</h2></div></div>
    <div class="compare-pick">
      <div class="field"><label for="a">服务商 A</label><select class="select" id="a">{rows.map((r, i) => <option value={r.id} selected={i === 0}>{r.name}</option>)}</select></div>
      <div class="field"><label for="b">服务商 B</label><select class="select" id="b">{rows.map((r, i) => <option value={r.id} selected={i === 1}>{r.name}</option>)}</select></div>
    </div>
    <div class="tbl-wrap"><table class="tbl" id="h2h" style="min-width:560px"><thead><tr><th>项目</th><th id="h-a"></th><th id="h-b"></th></tr></thead><tbody id="h2h-body"></tbody></table></div>
    <p class="muted" style="font-size:.88rem">差异行会高亮。对比只基于本站已收录的资料，没有资料的项目显示“暂无”。</p>
  </section>

  <section class="sec">
    <div class="split">
      <div class="article"><h2>怎么读这张表</h2>
        <ul>
          <li><b>价格口径不能直接比。</b>包月价、年付折算价、活动价是三回事。想算清楚每月成本，用<a href="/tools/">流量成本换算</a>。</li>
          <li><b>丢包率越低越好，但只是参考。</b>它是站长自测区间，样本和环境有限，见<a href="/data/">数据中心</a>里的方法说明。</li>
          <li><b>客户端是购买前的硬条件。</b>买完才发现不支持你的软件，是最容易踩的坑之一。</li>
          <li><b>资料标签描述信息来源，不是评分。</b>详见<a href="/methodology/">评测方法</a>。</li>
        </ul>
        <h2>常见问题</h2>
        <Faq items={faq} />
      </div>
      <aside class="aside"><div class="asidecard"><h2>相关</h2><ul><li><a href="/rankings/">综合排行榜</a></li><li><a href="/finder/">选购向导</a></li><li><a href="/airports/">机场导航</a></li><li><a href="/tools/">流量成本换算</a></li></ul></div></aside>
    </div>
  </section>

  <script type="application/json" id="cmp-data" set:html={safeJson(rows)} />
  <script>
    const tbody = document.querySelector<HTMLTableSectionElement>('#cmp tbody')!;
    const trs = [...tbody.querySelectorAll<HTMLTableRowElement>('tr')];
    const empty = document.getElementById('cmp-empty')!;
    let conf = 'all';
    let client = 'all';
    let onlyLoss = false;
    let sortKey = 'rank';
    let dir = 1;

    const render = () => {
      let shown = 0;
      const list = trs.slice().sort((a, b) => {
        if (sortKey === 'loss') {
          const av = a.dataset.loss === '' ? 99 : Number(a.dataset.loss);
          const bv = b.dataset.loss === '' ? 99 : Number(b.dataset.loss);
          return (av - bv) * dir;
        }
        return (Number(a.dataset.rank) - Number(b.dataset.rank)) * dir;
      });
      list.forEach((tr) => {
        tbody.appendChild(tr);
        const ok = (conf === 'all' || tr.dataset.conf === conf) && (client === 'all' || tr.dataset.client === client) && (!onlyLoss || tr.dataset.hasLoss === '1');
        tr.classList.toggle('hide', !ok);
        if (ok) shown++;
      });
      empty.classList.toggle('hide', shown > 0);
    };
    document.querySelectorAll<HTMLButtonElement>('.pill[data-conf]').forEach((b) =>
      b.addEventListener('click', () => {
        conf = b.dataset.conf!;
        document.querySelectorAll('.pill[data-conf]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
        render();
      }),
    );
    document.querySelectorAll<HTMLButtonElement>('.pill[data-client]').forEach((b) =>
      b.addEventListener('click', () => {
        client = b.dataset.client!;
        document.querySelectorAll('.pill[data-client]').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
        render();
      }),
    );
    const ol = document.getElementById('only-loss')!;
    ol.addEventListener('click', () => {
      onlyLoss = !onlyLoss;
      ol.setAttribute('aria-pressed', onlyLoss ? 'true' : 'false');
      render();
    });
    document.querySelectorAll<HTMLButtonElement>('th button[data-sort]').forEach((b) =>
      b.addEventListener('click', () => {
        const k = b.dataset.sort!;
        dir = sortKey === k ? -dir : 1;
        sortKey = k;
        document.querySelectorAll('#cmp thead th').forEach((th) => th.removeAttribute('aria-sort'));
        b.closest('th')!.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
        render();
      }),
    );

    // 两两对比
    type Row = Record<string, string | number | null>;
    const data = JSON.parse(document.getElementById('cmp-data')!.textContent!) as Row[];
    const selA = document.getElementById('a') as HTMLSelectElement;
    const selB = document.getElementById('b') as HTMLSelectElement;
    const body = document.getElementById('h2h-body')!;
    const fields: [string, string][] = [
      ['综合名次', 'rank'], ['资料标签', 'confLabel'], ['起步价', 'price'], ['价格口径', 'basis'], ['丢包率（自测）', 'loss'],
      ['客户端', 'clientLabel'], ['客户端说明', 'clientText'], ['官方入口', 'entry'], ['协议', 'protocols'], ['解锁检测', 'unlock'], ['需要留意', 'flags'],
    ];
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
    const h2h = () => {
      const a = data.find((r) => r.id === selA.value)!;
      const b = data.find((r) => r.id === selB.value)!;
      document.getElementById('h-a')!.innerHTML = `<a href="/airports/${esc(a.slug)}/">${esc(a.name)}</a>`;
      document.getElementById('h-b')!.innerHTML = `<a href="/airports/${esc(b.slug)}/">${esc(b.name)}</a>`;
      body.innerHTML = fields
        .map(([label, key]) => {
          const diff = String(a[key]) !== String(b[key]);
          return `<tr${diff ? ' style="background:color-mix(in srgb,var(--amber) 14%,transparent)"' : ''}><th scope="row">${label}</th><td>${esc(a[key])}</td><td>${esc(b[key])}</td></tr>`;
        })
        .join('');
    };
    selA.addEventListener('change', h2h);
    selB.addEventListener('change', h2h);
    h2h();
    render();
  </script>
</BaseLayout>
