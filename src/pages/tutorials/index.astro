---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveCanonicalUrl } from '../../config/seo';

const tutorials = await getCollection('tutorials');

const GROUP_ORDER = ['basics', 'clients', 'troubleshooting', 'advanced'] as const;
const GROUP_LABEL: Record<(typeof GROUP_ORDER)[number], string> = {
  basics: '新手先读',
  clients: '客户端入门',
  troubleshooting: '常见问题',
  advanced: '进阶理解',
};
const GROUP_DESC: Record<(typeof GROUP_ORDER)[number], string> = {
  basics: '第一次接触机场代理，先从这里了解基本概念和怎么选。',
  clients: 'Clash Verge Rev、小火箭、Clash Meta for Android、v2rayN 等客户端的下载与订阅导入方法。',
  troubleshooting: '连接失败、速度慢、订阅导不进去，遇到问题先来这里查。',
  advanced: '节点、线路、协议、丢包率这些术语，以及 Clash 规则模式、TUN 模式具体是什么意思。',
};

const groups = GROUP_ORDER.map((key) => ({
  key,
  label: GROUP_LABEL[key],
  description: GROUP_DESC[key],
  items: tutorials
    .filter((t) => t.data.group === key)
    .sort((a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime()),
}));

const title = '机场使用教程：Clash、小火箭、v2rayN 订阅导入与翻墙问题排查｜机场TJ';
const description = '机场（梯子）新手教程合集：机场是什么、怎么选，Clash Verge Rev、小火箭 Shadowrocket、Clash Meta for Android、v2rayN 订阅导入教程，以及连不上、速度慢等常见问题排查。';
const canonicalUrl = resolveCanonicalUrl('/tutorials/');
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <nav aria-label="Breadcrumb"><a href="/">首页</a> › 使用教程</nav>

  <h1>机场使用教程：Clash / 小火箭 / v2rayN</h1>
  <p>从"机场和梯子是什么"到各平台客户端的订阅导入、常见问题排查，按由浅入深整理。只想快速上手 Clash 的话，先看<a href="/clash/">Clash 教程与客户端推荐</a>。内容会持续补充，暂时没有覆盖到的问题，欢迎通过<a href="/contact/">联系方式</a>告诉我们。</p>

  {
    groups.map((group) => (
      <section class="tutorial-group">
        <h2>{group.label}</h2>
        <p class="tutorial-group__desc">{group.description}</p>
        {group.items.length > 0 ? (
          <div class="tutorial-list">
            {group.items.map((item) => (
              <a href={`/tutorials/${item.id}/`} class="tutorial-card">
                <strong>{item.data.title}</strong>
                <span>{item.data.description}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="tutorial-group__empty">这一类还在补充中，暂时没有文章。</p>
        )}
      </section>
    ))
  }

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/clash/">Clash 教程与客户端推荐</a></li>
    <li><a href="/rankings/">机场推荐排行榜</a></li>
    <li><a href="/scenarios/">按场景选机场</a></li>
    <li><a href="/methodology/">评测方法与数据说明</a></li>
  </ul>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: resolveCanonicalUrl('/') },
        { '@type': 'ListItem', position: 2, name: '使用教程', item: canonicalUrl },
      ],
    })}
  />
</BaseLayout>
