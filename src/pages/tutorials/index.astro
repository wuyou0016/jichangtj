---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/Crumbs.astro';
import { loadSite } from '../../data/helpers';
import { resolveCanonicalUrl, formatDate } from '../../config/seo';

const { tutorials } = await loadSite();
const GROUPS: [string, string, string][] = [
  ['basics', '新手先读', '机场是什么、和 VPN 有什么区别、第一次怎么选。'],
  ['clients', '客户端入门', '拿到订阅链接之后：用什么客户端、怎么导入。'],
  ['troubleshooting', '常见问题', '导入失败、连不上、很慢，按顺序排查。'],
  ['advanced', '进阶理解', '节点、线路、协议这些词到底是什么意思。'],
];
const title = '机场使用教程：新手入门、客户端导入订阅、连接失败排查｜机场TJ';
const description = '机场TJ 使用教程：机场代理是什么、怎么选，Windows / macOS / iOS / Android 客户端怎么导入订阅，连不上、订阅失败、速度慢怎么排查，以及节点、线路、协议术语解释。';
---

<BaseLayout title={title} description={description} canonical={resolveCanonicalUrl('/tutorials/')}>
  <Crumbs items={[{ name: '使用教程', href: '/tutorials/' }]} />
  <div class="banner">
    <p class="eyebrow">教程 · Tutorials</p>
    <h1>使用教程：从入门到排错</h1>
    <p class="lead">按“新手先读 → 客户端入门 → 常见问题 → 进阶理解”的顺序排列。想系统地学判断方法，也可以去<a href="/knowledge/" style="color:var(--amber)">知识库</a>。</p>
  </div>
  {
    GROUPS.map(([k, label, blurb]) => {
      const items = tutorials.filter((t) => t.data.group === k);
      return items.length > 0 && (
        <section class="sec">
          <div class="sec-head"><div><h2>{label}</h2><p>{blurb}</p></div></div>
          <div class="cards cards--2">
            {items.map((t) => <a class="card" href={`/tutorials/${t.id}/`}><p style="margin:0 0 8px"><span class="tag">{label}</span> <span class="muted" style="font-size:.8rem;margin-left:6px">更新 {formatDate(t.data.updatedAt)}</span></p><h3>{t.data.title}</h3><p class="muted" style="margin:0">{t.data.description}</p></a>)}
          </div>
        </section>
      );
    })
  }
</BaseLayout>
