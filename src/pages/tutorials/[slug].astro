---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { resolveCanonicalUrl } from '../../config/seo';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials');
  return tutorials.map((tutorial) => ({
    params: { slug: tutorial.id },
    props: { tutorial },
  }));
}

interface Props {
  tutorial: Awaited<ReturnType<typeof getCollection<'tutorials'>>>[number];
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);

const GROUP_LABEL: Record<string, string> = {
  basics: '新手先读',
  clients: '客户端入门',
  troubleshooting: '常见问题',
  advanced: '进阶理解',
};

const allScenarios = await getCollection('scenarios');
const relatedScenarios = allScenarios.filter((s) => tutorial.data.relatedScenarios?.includes(s.data.slug));

// 同组教程优先，其次是其他组，最多 4 篇，给教程之间互相导流。
const allTutorials = (await getCollection('tutorials')).filter((t) => t.id !== tutorial.id);
const relatedTutorials = [
  ...allTutorials.filter((t) => t.data.group === tutorial.data.group),
  ...allTutorials.filter((t) => t.data.group !== tutorial.data.group),
].slice(0, 4);

function formatDate(value: Date): string {
  return value.toISOString().slice(0, 10);
}

const title = `${tutorial.data.title}｜机场TJ`;
const description = tutorial.data.description;
const canonicalUrl = resolveCanonicalUrl(`/tutorials/${tutorial.id}/`);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogType="article"
  publishedTime={formatDate(tutorial.data.publishedAt)}
  modifiedTime={formatDate(tutorial.data.updatedAt)}
>
  <nav aria-label="Breadcrumb">
    <a href="/">首页</a> › <a href="/tutorials/">使用教程</a> › {tutorial.data.title}
  </nav>

  <p class="status-dot">{GROUP_LABEL[tutorial.data.group] ?? tutorial.data.group}</p>
  <h1>{tutorial.data.title}</h1>
  <p class="hub-stats">发布于 {formatDate(tutorial.data.publishedAt)} · 更新于 {formatDate(tutorial.data.updatedAt)}</p>

  <div class="article-body">
    <Content />
  </div>

  {tutorial.data.faq && <FaqSection items={tutorial.data.faq} />}

  {
    relatedTutorials.length > 0 && (
      <>
        <h2>相关教程</h2>
        <div class="tutorial-list">
          {relatedTutorials.map((t) => (
            <a href={`/tutorials/${t.id}/`} class="tutorial-card">
              <span class="tutorial-card__group">{GROUP_LABEL[t.data.group] ?? t.data.group}</span>
              <strong>{t.data.title}</strong>
              <span>{t.data.description}</span>
            </a>
          ))}
        </div>
      </>
    )
  }

  {
    relatedScenarios.length > 0 && (
      <>
        <h2>相关场景</h2>
        <ul class="quick-links">
          {relatedScenarios.map((s) => (
            <li>
              <a href={`/scenarios/${s.data.slug}/`}>{s.data.title}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/clash/">Clash 教程与客户端推荐</a></li>
    <li><a href="/rankings/">机场推荐排行榜</a></li>
    <li><a href="/tutorials/">查看全部使用教程</a></li>
  </ul>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: tutorial.data.title,
      description,
      url: canonicalUrl,
      datePublished: tutorial.data.publishedAt.toISOString().slice(0, 10),
      dateModified: tutorial.data.updatedAt.toISOString().slice(0, 10),
      author: { '@type': 'Organization', name: siteConfig.brandName },
      publisher: { '@type': 'Organization', name: siteConfig.brandName },
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: resolveCanonicalUrl('/') },
        { '@type': 'ListItem', position: 2, name: '使用教程', item: resolveCanonicalUrl('/tutorials/') },
        { '@type': 'ListItem', position: 3, name: tutorial.data.title, item: canonicalUrl },
      ],
    })}
  />
</BaseLayout>
