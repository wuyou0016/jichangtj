---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { resolveCanonicalUrl } from '../../config/seo';
import { DATA_CONFIDENCE_LABEL, DATA_CONFIDENCE_TONE, type DataConfidence } from '../../config/data-confidence';

// 目录展示顺序（与场景推荐无关，纯前台陈列顺序）：
// 无忧链接是本站资料最完整、唯一有本站真实流媒体解锁测试的服务商，固定排最前面。
const providers = [...(await getCollection('providers'))].sort((a, b) => {
  if (a.id === 'wuyou-lianjie') return -1;
  if (b.id === 'wuyou-lianjie') return 1;
  return 0;
});

const statusLabel: Record<string, string> = {
  active: '正常运营',
  inactive: '暂停服务',
  discontinued: '已停止服务',
  watch: '观察中',
};

const title = '机场对比导航｜机场代理服务商目录与对比表｜机场TJ';
const description = '浏览并对比机场TJ收录的机场代理服务商——运营状态、数据可信度一览表，逐个查看官方信息、第三方资料与场景适配说明。';
const canonicalUrl = resolveCanonicalUrl('/airports/');
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <Breadcrumbs items={[{ name: '首页', href: '/' }, { name: '机场导航', href: '/airports/' }]} />

  <h1>机场导航｜机场代理服务商目录</h1>
  <p>
    这里是完整的服务商列表，逐个查看官方信息、第三方资料和场景适配说明。如果你已经知道自己的使用场景，直接去<a href="/scenarios/">按场景选</a>更快；如果分不清"机场""梯子""VPN"这几个词的关系，先看<a href="/glossary/airport-ladder-vpn-difference/">这篇辨析</a>。
  </p>

  <h2>对比一览表</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>服务商</th>
          <th>运营状态</th>
          <th>数据可信度</th>
          <th>详情</th>
        </tr>
      </thead>
      <tbody>
        {
          providers.map((provider) => (
            <tr>
              <td>{provider.data.name}</td>
              <td>{statusLabel[provider.data.status] ?? provider.data.status}</td>
              <td>{DATA_CONFIDENCE_LABEL[provider.data.dataConfidence as DataConfidence]}</td>
              <td><a href={`/airports/${provider.data.slug}/`}>查看详情 →</a></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="hub-stats">
    表格只列可核实的基础状态字段，不是评分。数据可信度标签代表"这份资料是怎么来的"，具体含义见<a href="/methodology/">评测方法与数据说明</a>。
  </p>

  <h2>逐个查看</h2>
  <div class="provider-grid">
    {
      providers.map((provider) => (
        <a href={`/airports/${provider.data.slug}/`} class="provider-card">
          <div>
            <strong>{provider.data.name}</strong>
          </div>
          <span class="status-dot">{statusLabel[provider.data.status] ?? provider.data.status}</span>
          <span
            class={`confidence-tag confidence-tag--${DATA_CONFIDENCE_TONE[provider.data.dataConfidence as DataConfidence]}`}
          >
            {DATA_CONFIDENCE_LABEL[provider.data.dataConfidence as DataConfidence]}
          </span>
        </a>
      ))
    }
  </div>

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/scenarios/">按场景选</a></li>
    <li><a href="/rankings/">综合推荐榜</a></li>
    <li><a href="/tutorials/how-to-avoid-risky-airports/">避坑指南：怎么识别高风险服务商</a></li>
    <li><a href="/tutorials/">使用教程</a></li>
  </ul>
</BaseLayout>
