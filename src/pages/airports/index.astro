---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveCanonicalUrl } from '../../config/seo';
import { DATA_CONFIDENCE_LABEL, DATA_CONFIDENCE_TONE, type DataConfidence } from '../../config/data-confidence';
import { THIRD_PARTY_CLIENT_LABEL, airportName, formatPacketLoss, formatStartingPrice } from '../../config/provider-facts';

// 目录展示顺序（与场景推荐无关，纯前台陈列顺序）：
// 无忧链接是本站资料最完整、唯一有本站真实流媒体解锁测试的服务商，固定排最前面。
const providers = [...(await getCollection('providers'))].sort((a, b) => {
  if (a.id === 'wuyou-lianjie') return -1;
  if (b.id === 'wuyou-lianjie') return 1;
  return 0;
});

const statusLabel: Record<string, string> = {
  active: '正常运营',
  inactive: '暂停服务',
  discontinued: '已停止服务',
  watch: '观察中',
};

const title = `机场导航：${providers.length} 家机场官网、价格与实测数据一览｜机场TJ`;
const description = `机场TJ 已收录的 ${providers.length} 家机场（梯子）服务商目录：起步价、实测丢包率、Clash 客户端支持情况与资料来源一览，点进详情页查看官网入口和完整资料。`;
const canonicalUrl = resolveCanonicalUrl('/airports/');
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <nav aria-label="Breadcrumb"><a href="/">首页</a> › 机场导航</nav>

  <h1>机场导航：已收录 {providers.length} 家机场一览</h1>
  <p>
    这里是本站收录的全部机场服务商，每张卡片列出起步价、本站实测丢包率和第三方客户端（Clash、小火箭等）支持情况，点进去可以看官网入口、第三方资料来源和适合场景。想直接看排序，去<a href="/rankings/">机场推荐排行榜</a>；已经知道自己的使用场景，去<a href="/scenarios/">按场景选</a>更快。
  </p>

  <div class="provider-grid">
    {
      providers.map((provider) => {
        const facts = provider.data.quickFacts;
        return (
          <a href={`/airports/${provider.data.slug}/`} class="provider-card">
            <div>
              <strong>{airportName(provider.data.name)}</strong>
            </div>
            <span class="status-dot">{statusLabel[provider.data.status] ?? provider.data.status}</span>
            <span
              class={`confidence-tag confidence-tag--${DATA_CONFIDENCE_TONE[provider.data.dataConfidence as DataConfidence]}`}
            >
              {DATA_CONFIDENCE_LABEL[provider.data.dataConfidence as DataConfidence]}
            </span>
            <span class="provider-card__facts">
              起步价：{formatStartingPrice(facts)}
              <br />
              实测丢包率：{formatPacketLoss(facts)}
              <br />
              Clash 等第三方客户端：{THIRD_PARTY_CLIENT_LABEL[facts.thirdPartyClient]}
            </span>
          </a>
        );
      })
    }
  </div>

  <h2>怎么用这份机场导航</h2>
  <ul>
    <li><strong>先定场景再挑机场</strong>：便宜、游戏、远程办公、流媒体关注的指标不一样，见<a href="/scenarios/">按场景选</a>。</li>
    <li><strong>看资料来源标签</strong>："已有本站实测"表示本站做过丢包率等测试，"多来源资料参考"表示价格等信息有多个第三方来源互相印证，含义见<a href="/methodology/">评测方法</a>。</li>
    <li><strong>要用 Clash 先确认订阅</strong>：标"暂不支持"的只能用官方客户端，标"待确认"的建议购买前问客服；导入方法见<a href="/clash/">Clash 教程</a>。</li>
  </ul>

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/rankings/">机场推荐排行榜</a></li>
    <li><a href="/tests/">机场实测数据</a></li>
    <li><a href="/scenarios/">按场景选机场</a></li>
    <li><a href="/tutorials/">使用教程</a></li>
  </ul>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: title,
      description,
      url: canonicalUrl,
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: resolveCanonicalUrl('/') },
        { '@type': 'ListItem', position: 2, name: '机场导航', item: canonicalUrl },
      ],
    })}
  />
</BaseLayout>
