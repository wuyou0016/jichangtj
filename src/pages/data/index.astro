---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/Crumbs.astro';
import Chip from '../../components/Chip.astro';
import Callout from '../../components/Callout.astro';
import LossRange from '../../components/LossRange.astro';
import Faq from '../../components/Faq.astro';
import { loadSite } from '../../data/helpers';
import { FACTS, ENTRY_LABEL } from '../../data/providers/facts';
import { DATA_CONFIDENCE_LABEL, type DataConfidence } from '../../config/data-confidence';
import { resolveCanonicalUrl, formatDate } from '../../config/seo';

const { providers, rankOf } = await loadSite();
const ordered = [...providers].sort((a, b) => (rankOf.get(a.id) ?? 99) - (rankOf.get(b.id) ?? 99));
const withLoss = ordered.filter((p) => FACTS[p.id]?.loss);
const lows = withLoss.map((p) => FACTS[p.id]!.loss!);
const best = Math.min(...lows.map((l) => l.min));
const worst = Math.max(...lows.map((l) => l.max));
const rangeRows = ordered.map((p) => ({ id: p.id, name: p.data.name, href: `/airports/${p.data.slug}/` }));
const counts = (Object.keys(DATA_CONFIDENCE_LABEL) as DataConfidence[]).map((k) => ({ k, label: DATA_CONFIDENCE_LABEL[k], n: providers.filter((p) => p.data.dataConfidence === k).length }));
const latestVerified = formatDate(new Date(Math.max(...providers.map((p) => +p.data.lastVerified))));
const yesCls = (v: boolean) => (v ? 'chip chip--own' : 'chip chip--inc');
const faq = [
  { q: '这些数据是怎么测的？', a: '站长用 MiaoKo 自定义测速工具，在珠海联通网络环境下对各服务商持续跟踪丢包率，同一服务商在不同日期反复测，页面上的区间是多次测试的范围。部分服务商另做过流媒体解锁检测。' },
  { q: '为什么只有无忧链接有解锁检测？', a: '解锁检测只对个别服务商做过。其余服务商的解锁描述是第三方转述的服务商宣传，本站没有独立验证，因此不在这里展示，也不据此推荐。' },
  { q: '丢包率数据能说明什么、不能说明什么？', a: '能说明在站长的测试环境下，各家的相对稳定程度；不能说明你所在地区、运营商和时段的体验，也不能代表打某个具体游戏或看某个具体平台的效果。' },
  { q: '数据会更新吗？', a: '有新的测试结果时会更新，并在更新日志里记录。目前数据的最近核实日期是 ' + latestVerified + '。' },
];
const title = '机场数据中心：站长自测丢包率与解锁检测汇总｜机场TJ';
const description = '机场TJ 数据中心汇总站长自测数据：7 家服务商的丢包率区间图表、无忧链接的流媒体解锁检测结果、各服务商数据覆盖矩阵与资料标签分布，并说明测试环境与局限，每项数据都标明日期与测试环境。';
---

<BaseLayout
  title={title}
  description={description}
  canonical={resolveCanonicalUrl('/data/')}
  ld={[{ '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: resolveCanonicalUrl('/data/'), dateModified: latestVerified }]}
>
  <Crumbs items={[{ name: '数据中心', href: '/data/' }]} />
  <div class="banner">
    <p class="eyebrow">数据中心 · Data</p>
    <h1>数据中心：站长自测数据一览</h1>
    <p class="lead">这里汇总本站所有“自己测出来”的数据，并明确它们的范围：什么环境、什么时间、测了什么、没测什么。没有数据的地方不会用别的数字凑。</p>
    <div class="metarow"><span>最近核实 {latestVerified}</span><span class="sep">·</span><span>环境：珠海联通</span><span class="sep">·</span><span>工具：MiaoKo</span></div>
  </div>

  <section class="sec" style="margin-top:28px">
    <div class="stats">
      <div class="stat"><b>{withLoss.length}</b><span>家有丢包率跟踪</span></div>
      <div class="stat"><b>{best}–{worst}%</b><span>已测服务商的丢包率区间</span></div>
      <div class="stat"><b>49/50</b><span>无忧链接节点解锁正常</span></div>
      <div class="stat"><b>{providers.length - withLoss.length}</b><span>家暂无测试数据</span></div>
    </div>
  </section>

  <section class="sec" aria-labelledby="loss-h">
    <div class="sec-head"><div><p class="eyebrow">丢包率 · Packet loss</p><h2 id="loss-h">丢包率区间对比</h2><p>数值越小越好。每条横杠是多批次测试的数值范围，不是单次数据；颜色只表示区间档位，不是评分。</p></div></div>
    <div class="card"><LossRange rows={rangeRows} /></div>
    <p class="muted" style="font-size:.86rem;margin-top:12px">图例：绿色 = 区间上限在 1% 以内；蓝色 = 1%–2.8%；橙色 = 2.8% 以上。分档只是为了看图方便，不代表“好 / 坏”的结论。</p>
    <div class="tbl-wrap" style="margin-top:16px">
      <table class="tbl">
        <thead><tr><th>服务商</th><th>丢包率区间</th><th>备注</th><th>综合名次</th></tr></thead>
        <tbody>
          {withLoss.map((p) => { const l = FACTS[p.id]!.loss!; return <tr><th scope="row"><a href={`/airports/${p.data.slug}/`}>{p.data.name}</a></th><td class="num">{l.min}%–{l.max}%</td><td>{l.note ?? '—'}</td><td class="num">#{String(rankOf.get(p.id)).padStart(2, '0')}</td></tr>; })}
        </tbody>
      </table>
    </div>
  </section>

  <section class="sec" aria-labelledby="unlock-h">
    <div class="sec-head"><div><p class="eyebrow">解锁检测 · Unlock</p><h2 id="unlock-h">流媒体解锁检测</h2><p>目前只对无忧链接做过检测：50 个节点，检测 YouTube / Netflix / Disney+。</p></div></div>
    <div class="card">
      <div style="display:flex;height:34px;border-radius:8px;overflow:hidden;border:1px solid var(--line)" role="img" aria-label="50 个节点中 49 个解锁正常，1 个被识别为送中">
        <div style="width:98%;background:var(--go);color:#fff;display:grid;place-items:center;font:700 .85rem var(--mono)">49 个解锁正常</div>
        <div style="width:2%;background:var(--stop)" title="1 个送中"></div>
      </div>
      <p style="margin:12px 0 0">另有 <b>1 个香港节点</b>被识别为“送中”（显示为大陆地区而非目标地区），如实保留在记录里，没有删除。这是节点层面的个体差异，不代表整体不可用。</p>
      <p class="muted" style="margin:8px 0 0;font-size:.88rem">其余收录服务商没有独立检测，第三方资料里的“完美解锁”只是转述服务商自己的宣传，本站不据此展示。AI 工具（如 ChatGPT）的访问是另一件事，未在此检测。</p>
    </div>
  </section>

  <section class="sec" aria-labelledby="cov-h">
    <div class="sec-head"><div><p class="eyebrow">覆盖 · Coverage</p><h2 id="cov-h">数据覆盖矩阵</h2><p>每家服务商，本站有什么、没有什么。一目了然，也提醒你哪些需要自己验证。</p></div></div>
    <div class="tbl-wrap">
      <table class="tbl" style="min-width:760px">
        <thead><tr><th>服务商</th><th>价格多来源印证 / 站长确认</th><th>丢包率自测</th><th>解锁检测</th><th>官方套餐页可看</th><th>资料标签</th></tr></thead>
        <tbody>
          {
            ordered.map((p) => {
              const f = FACTS[p.id]!;
              const priceOk = f.price.basis.includes('站长确认') || f.price.basis.includes('两个');
              return (
                <tr>
                  <th scope="row"><a href={`/airports/${p.data.slug}/`}>{p.data.name}</a></th>
                  <td><span class={yesCls(priceOk)}>{priceOk ? "有" : "无"}</span></td>
                  <td><span class={yesCls(Boolean(f.loss))}>{f.loss ? "有" : "无"}</span></td>
                  <td><span class={yesCls(Boolean(f.unlock))}>{f.unlock ? "有" : "无"}</span></td>
                  <td><span class="chip chip--inc">{ENTRY_LABEL[f.entry.kind]}</span></td>
                  <td><Chip c={p.data.dataConfidence as DataConfidence} /></td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="muted" style="font-size:.86rem">“官方套餐页可看”一栏：本站访问官方入口时，都遇到了验证码、注册墙、中转页或访问失败，没有一家能不经额外步骤直接看到完整套餐。这不一定代表服务有问题，但意味着价格与规则只能靠你购买前自己打开核对。</p>
  </section>

  <section class="sec" aria-labelledby="dist-h">
    <div class="sec-head"><div><p class="eyebrow">标签 · Labels</p><h2 id="dist-h">资料标签分布</h2></div></div>
    <div class="cards cards--4">
      {counts.map((c) => <div class="card"><p style="margin:0 0 6px"><Chip c={c.k} /></p><p class="mono" style="font-size:2rem;font-weight:800;margin:0;line-height:1.1">{c.n}<span class="muted" style="font-size:.9rem;font-weight:600"> / {providers.length}</span></p><p class="muted" style="font-size:.84rem;margin:6px 0 0">{c.label}</p></div>)}
    </div>
  </section>

  <section class="sec">
    <div class="split">
      <div class="article">
        <h2>这些数据的局限</h2>
        <Callout tone="warn" label="局限">
          <ul style="margin:0">
            <li><b>固定环境。</b>测试在珠海联通网络下完成，不代表其他城市、运营商或境外网络。</li>
            <li><b>区间而非单次。</b>同一服务商在不同日期反复测，展示的是多批次数值范围。</li>
            <li><b>样本期有限。</b>数据集中在 2026 年 9 月，观察天数仍在积累，是早期结果。</li>
            <li><b>通用丢包率。</b>不针对具体游戏服务器或具体网站，只能作为稳定性的参考起点。</li>
            <li><b>没测的维度不写。</b>下载 / 上传速率、延迟、长期运营稳定性、客服质量，本站暂无测试数据。</li>
          </ul>
        </Callout>
        <h2>常见问题</h2>
        <Faq items={faq} />
      </div>
      <aside class="aside"><div class="asidecard"><h2>相关</h2><ul>
        <li><a href="/methodology/">评测方法与数据说明</a></li>
        <li><a href="/knowledge/loss-latency-jitter-explained/">丢包、延迟、抖动是什么</a></li>
        <li><a href="/knowledge/self-test-seven-days/">一周自测计划</a></li>
        <li><a href="/compare/">服务商对比</a></li>
        <li><a href="/updates/">更新日志</a></li>
      </ul></div></aside>
    </div>
  </section>
</BaseLayout>
