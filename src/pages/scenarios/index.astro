---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Crumbs from '../../components/Crumbs.astro';
import Chip from '../../components/Chip.astro';
import { loadSite, shortName } from '../../data/helpers';
import { resolveCanonicalUrl } from '../../config/seo';
import type { DataConfidence } from '../../config/data-confidence';

const { scenarios, byId } = await loadSite();
const groupA = scenarios.filter((s) => s.data.gate?.startsWith('A'));
const groupB = scenarios.filter((s) => s.data.gate?.startsWith('B'));
const title = '机场代理按场景选：新手、预算、游戏、办公、流媒体等 8 类｜机场TJ';
const description = '机场代理该怎么选，取决于你用来做什么。机场TJ 按新手入门、预算有限、游戏加速、远程办公、流媒体解锁、学习、出差出境、怕跑路 8 个场景，分别说明该看什么指标和常见误区。';
---

<BaseLayout title={title} description={description} canonical={resolveCanonicalUrl('/scenarios/')}>
  <Crumbs items={[{ name: '按场景选', href: '/scenarios/' }]} />
  <div class="banner">
    <p class="eyebrow">场景 · Gates</p>
    <h1>机场代理，按你的使用场景选</h1>
    <p class="lead">不存在“适合所有人的最好机场”。游戏在意丢包，办公在意长期不掉线，预算在意价格口径，流媒体在意解锁有没有被独立验证。先选登机口，再看推荐。</p>
    <div class="metarow"><span>{scenarios.length} 个场景</span><span class="sep">·</span><span>每个场景含判断指标、常见误区、检查清单与 FAQ</span></div>
  </div>

  <section class="sec">
    <div class="sec-head"><div><h2>A 区：核心需求</h2><p>最常见的四类需求，各自关注的指标完全不同。</p></div></div>
    <div class="cards cards--2">
      {
        groupA.map((s) => {
          const first = byId.get(s.data.picks[0]?.providerId.id ?? '');
          return (
            <a class="card" href={`/scenarios/${s.data.slug}/`}>
              <p style="display:flex;gap:10px;align-items:center;margin:0 0 10px"><span class="gate">{s.data.gate}</span><span class="muted" style="font-size:.84rem">{s.data.whatMatters.length} 个判断指标 · {s.data.picks.length} 个推荐</span></p>
              <h3>{s.data.title}</h3>
              <p class="muted">{s.data.summary}</p>
              {first && <p style="margin:10px 0 0;display:flex;gap:8px;align-items:center;flex-wrap:wrap"><span class="muted" style="font-size:.86rem">首选</span><b>{first.data.name}</b><Chip c={first.data.dataConfidence as DataConfidence} /></p>}
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="sec">
    <div class="sec-head"><div><h2>B 区：人群与情境</h2><p>按“你是谁、在什么情况下用”来选。</p></div></div>
    <div class="cards cards--2">
      {
        groupB.map((s) => {
          const first = byId.get(s.data.picks[0]?.providerId.id ?? '');
          return (
            <a class="card" href={`/scenarios/${s.data.slug}/`}>
              <p style="display:flex;gap:10px;align-items:center;margin:0 0 10px"><span class="gate">{s.data.gate}</span><span class="muted" style="font-size:.84rem">{s.data.whatMatters.length} 个判断指标 · {s.data.picks.length} 个推荐</span></p>
              <h3>{s.data.title}</h3>
              <p class="muted">{s.data.summary}</p>
              {first && <p style="margin:10px 0 0;display:flex;gap:8px;align-items:center;flex-wrap:wrap"><span class="muted" style="font-size:.86rem">首选</span><b>{first.data.name}</b><Chip c={first.data.dataConfidence as DataConfidence} /></p>}
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="sec">
    <div class="callout callout--info"><b>提示</b><div><p>想要更快的结论？用<a href="/finder/">选购向导</a>回答 3 个问题；想看全部服务商的价格口径与数据，进入<a href="/compare/">对比中心</a>；不想分场景，直接看<a href="/rankings/">综合排行榜</a>。</p></div></div>
  </section>
</BaseLayout>
