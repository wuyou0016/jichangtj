---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { resolveCanonicalUrl } from '../../config/seo';

const scenarios = (await getCollection('scenarios')).sort(
  (a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime(),
);

const title = '按场景选机场｜游戏、流媒体、办公、预算怎么选｜机场TJ';
const description = '按使用场景分类的机场代理选择建议入口——游戏加速、流媒体解锁、远程办公、预算有限，每个场景关注的维度不一样。';
const canonicalUrl = resolveCanonicalUrl('/scenarios/');
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <Breadcrumbs items={[{ name: '首页', href: '/' }, { name: '按场景选', href: '/scenarios/' }]} />

  <h1>按场景选机场</h1>
  <p>不同用途关注的维度完全不一样，先找到最接近你情况的场景。看完场景推荐，还想了解机场、梯子、VPN 这些概念本身，可以去<a href="/glossary/">术语库</a>。</p>

  <div class="scenario-grid">
    {
      scenarios.map((scenario) => (
        <a href={`/scenarios/${scenario.data.slug}/`} class="scenario-card">
          <span class="scenario-card__emoji">{scenario.data.emoji}</span>
          <span class="scenario-card__title">{scenario.data.title}</span>
          <p class="scenario-card__desc">{scenario.data.description}</p>
        </a>
      ))
    }
  </div>

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/airports/">查看机场导航</a></li>
    <li><a href="/rankings/">综合推荐榜</a></li>
    <li><a href="/tutorials/">使用教程</a></li>
  </ul>
</BaseLayout>
