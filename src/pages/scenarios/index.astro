---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveCanonicalUrl } from '../../config/seo';

const scenarios = (await getCollection('scenarios')).sort(
  (a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime(),
);

const title = '按场景选机场：便宜机场、游戏机场、稳定办公与流媒体机场推荐｜机场TJ';
const description = '按使用场景挑机场（梯子）：预算有限看单位流量成本，游戏加速和远程办公看实测丢包率，流媒体解锁看真实测试记录，每个场景分别给出推荐和常见误区。';
const canonicalUrl = resolveCanonicalUrl('/scenarios/');
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <nav aria-label="Breadcrumb"><a href="/">首页</a> › 按场景选</nav>

  <h1>按场景选机场</h1>
  <p>
    不同用途关注的维度完全不一样：便宜机场看单位流量成本，游戏机场和远程办公看丢包率，流媒体机场看有没有真实解锁记录。先找到最接近你情况的场景，再看对应的推荐和常见误区；不想细分的话，直接看<a href="/rankings/">机场推荐排行榜</a>。
  </p>

  <div class="scenario-grid">
    {
      scenarios.map((scenario) => (
        <a href={`/scenarios/${scenario.data.slug}/`} class="scenario-card">
          <span class="scenario-card__emoji">{scenario.data.emoji}</span>
          <span class="scenario-card__title">{scenario.data.title}</span>
          <p class="scenario-card__desc">{scenario.data.description}</p>
        </a>
      ))
    }
  </div>

  <p>你可能还想看：</p>
  <ul class="quick-links">
    <li><a href="/rankings/">机场推荐排行榜</a></li>
    <li><a href="/tests/">机场实测数据</a></li>
    <li><a href="/airports/">机场导航</a></li>
    <li><a href="/tutorials/">使用教程</a></li>
  </ul>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: resolveCanonicalUrl('/') },
        { '@type': 'ListItem', position: 2, name: '按场景选', item: canonicalUrl },
      ],
    })}
  />
</BaseLayout>
