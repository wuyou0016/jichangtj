---
import { breadcrumbLd, type Crumb } from '../config/seo';
import { safeJson } from '../data/helpers';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="面包屑">
  <a href="/">首页</a>
  {items.map((c, i) => (
    <>
      <span aria-hidden="true">›</span>
      {i < items.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
    </>
  ))}
</nav>
<script type="application/ld+json" set:html={safeJson(breadcrumbLd(items))} />
