---
// 常见问题区块：页面上可见的问答 + FAQPage 结构化数据，两者内容完全一致。
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}

const { items, heading = '常见问题' } = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

{
  items.length > 0 && (
    <section class="faq">
      <h2>{heading}</h2>
      {items.map((item) => (
        <div class="faq__item">
          <h3 class="faq__q">{item.q}</h3>
          <p class="faq__a">{item.a}</p>
        </div>
      ))}
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    </section>
  )
}
